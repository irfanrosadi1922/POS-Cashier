# Salin menjadi .env lalu isi
# Sandi akun owner pertama (username: owner). Hanya dipakai saat pertama kali jalan.
POS_PASSWORD=ganti-dengan-sandi-yang-kuat
# Lupa sandi owner? isi RESET_OWNER_PASSWORD=1 sekali saja (lihat README 3b)
# RESET_OWNER_PASSWORD=1
# Zona waktu toko (nomor antrean pesanan online reset tiap hari menurut zona ini)
# STORE_TZ=Asia/Jakarta
# Batas pesanan online per 10 menit per IP (default 40)
# ORDER_RATE=40
# Bila lewat Cloudflare Tunnel (tanpa jalankan-pos.bat), isi: TRUST_PROXY=cloudflare
# TRUST_PROXY=cloudflare
